{
  // 라이칸짐 연수점 — Cloudflare Workers: 정적 파일(assets) + 관리자 API·방문 통계(worker.js + D1)
  // 정적 파일이 있는 주소는 assets 가 먼저 응답하고, /api/* 와 /uploads/* 만 worker.js 로 간다.
  "name": "lycangym",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lycangym-db",
      "database_id": "e3cecb79-212d-430b-abd5-defa40d40d51",
      "migrations_dir": "migrations"
    }
  ]
}
