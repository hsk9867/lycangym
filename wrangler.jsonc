{
  // 라이칸짐 연수점 — Cloudflare Workers: 정적 파일(assets) + 관리자 API·방문 통계(worker.js + D1)
  // 정적 파일이 있는 주소는 assets 가 먼저 응답하고, /api/* 와 /uploads/* 만 worker.js 로 간다.
  "name": "lycangym",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "workers_dev": true,   // lycangym.hsk9867.workers.dev 도 계속 열어 둔다(점검용)
  // 커스텀 도메인 (라이칸짐.com = xn--oi2bw61a1wbh8g.com, Cloudflare 존에 DNS 레코드가 자동 생성됨)
  "routes": [
    { "pattern": "xn--oi2bw61a1wbh8g.com", "custom_domain": true },
    { "pattern": "www.xn--oi2bw61a1wbh8g.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lycangym-db",
      "database_id": "e3cecb79-212d-430b-abd5-defa40d40d51",
      "migrations_dir": "migrations"
    }
  ]
}
